# Copy to .env and adjust locally. .env is git-ignored; this file is not.

# Port for `npm run dev` and `npm run preview`. Defaults to 4000 if unset.
PORT=4000

# Anything the browser needs must be prefixed VITE_ and is read as
# import.meta.env.VITE_FOO — never put secrets in a VITE_ var, they ship
# in the bundle.
# VITE_API_URL=http://localhost:3000
